{
  "regions": ["fra1"],
  "functions": {
    "src/app/api/polymarket/**/*.ts": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/polymarket/proxy/:path*",
      "destination": "https://bands-production-1ac7.up.railway.app/api/polymarket/proxy/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src * 'unsafe-inline' 'unsafe-eval' data: blob:; frame-src *; connect-src *;"
        }
      ]
    }
  ]
}
