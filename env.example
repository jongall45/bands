# Privy - Required for authentication and smart wallets
# Get your app ID at https://dashboard.privy.io
NEXT_PUBLIC_PRIVY_APP_ID=your-privy-app-id

# Dune Sim API - Optional, enables "Your Tokens" feature in swap widget
# Get a free Sim API key at https://sim.dune.com (key starts with "sim_")
NEXT_PUBLIC_DUNE_API_KEY=sim_your-sim-api-key

# 0x - Optional, for additional swap routing
# Get your API key at https://0x.org/
NEXT_PUBLIC_ZERO_X_API_KEY=your-0x-api-key

# Polymarket - Optional, for builder attribution and enhanced features
# Sign up for the Builder Program at https://docs.polymarket.com/developers/builders/builder-intro
# Note: Basic trading works without these keys via public APIs
POLYMARKET_BUILDER_API_KEY=your-builder-api-key
POLYMARKET_BUILDER_API_SECRET=your-builder-api-secret
POLYMARKET_BUILDER_PASSPHRASE=your-builder-passphrase

# Polymarket Gateway - Required for production trading
# Deploy the gateway service from /gateway directory to get a stable IP
# This avoids Cloudflare blocking serverless function IPs
NEXT_PUBLIC_GATEWAY_URL=https://your-gateway.railway.app
